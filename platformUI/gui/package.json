{
  "name": "platform-gui",
  "version": "0.0.1",
  "description": "Ecstasy cloud platform",
  "productName": "Ecstasy Cloud",
  "author": "Milen Dyankov <milendyankov@gmail.com>",
  "private": true,
  "scripts": {
    "preinstall": "node -e \"const agent = process.env.npm_config_user_agent; if (agent && !agent.startsWith('yarn/')) { console.error('Use yarn to install the platform UI: yarn install'); process.exit(1) }\"",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build"
  },
  "dependencies": {
    "@quasar/extras": "^1.18.0",
    "axios": "^1.21.1",
    "node": "^24.22.3",
    "pinia": "^3.0.4",
    "quasar": "2.21.1",
    "vue": "^3.5.46",
    "vue-router": "^4.6.5",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@quasar/app-vite": "^2.6.2",
    "autoprefixer": "^10.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "vue-eslint-parser": "^10.4.2"
  },
  "engines": {
    "node": ">=22.16.0",
    "yarn": ">= 1.21.1"
  }
}
